// Brick cache tuning (decision 0007). Hot-reloads on save; a bad value is
// rejected and the last good tuning stays live. Fields marked "read at
// startup" size the GPU pools, which never grow: editing them needs a restart.
(
    // Distance (stage 1: CPU picks nodes and bricks by distance) or
    // RayGuided (stage 2: bricks are paged from ray requests).
    stage: Distance,
    // Pools on the floor Mac (--mac-floor), read at startup.
    // node_pool_mib 1..=4096, brick_pool_mib 16..=16384,
    // upload_budget_mib 1..=256 and at most the brick pool.
    floor: (
        node_pool_mib: 64,
        brick_pool_mib: 768,
        upload_budget_mib: 6,
    ),
    // Pools on the PC, read at startup.
    pc: (
        node_pool_mib: 128,
        brick_pool_mib: 2048,
        upload_budget_mib: 24,
    ),
    // Largest brick segment in MiB; 0 uses the adapter's binding limit.
    // Read at startup. 0..=4096
    max_segment_mib: 0,
    // Expected mean brick block size in bytes; sizes the brick id table.
    // Read at startup. 64..=16384
    mean_brick_bytes: 1024,
    // Evict when the brick pool is fuller than this fraction. 0.1..=1.0
    evict_threshold: 0.9,
    // Fraction of resident bricks one eviction pass tries to free. 0.001..=0.5
    evict_fraction: 0.05,
    // Bricks used within this many frames are never evicted. 2..=10000
    min_evict_age_frames: 30,
    // Ray requests per frame and victims per eviction pass.
    // Read at startup. 64..=1048576
    request_capacity: 16384,
    victim_capacity: 16384,
    lod: (
        // Stage 1 refines a node when its cells would cover this many
        // pixels. 0.05..=64.0
        detail_pixels: 1.0,
        // Stage 1 keeps a node refined until its cells shrink below
        // detail_pixels * hysteresis. 0.1..=1.0
        hysteresis: 0.7,
        // Rays stop where a cell is smaller than this many pixel
        // footprints; 0.0 traces at full resolution. 0.0..=16.0
        footprint_bias: 1.0,
        // Records stage 1 examines per frame; a larger walk resumes next
        // frame. 1024..=16777216
        max_visits_per_frame: 16384,
        // Stage 1 looks for nodes to refine again once the camera moved
        // this many voxels or the cache changed; 0 looks every frame.
        // 0.0..=4096.0
        regrow_voxels: 16.0,
        // A pass in progress starts over only once the camera moved this
        // many voxels (at least regrow_voxels); smaller moves let it finish.
        // 0.0..=65536.0
        restart_voxels: 128.0,
        // Nodes expanded per frame at most; the rest wait for the next
        // frame. Each costs tens of microseconds on the floor Mac.
        // 1..=1048576
        max_expansions_per_frame: 128,
        // Node summaries expansions may compute per frame (on one thread,
        // unlike a replaced chunk's); the rest wait. 1..=16777216
        max_expansion_summaries_per_frame: 2048,
        // Records the shrink walk (collapse, evict) examines per frame; it
        // only frees memory, so it may lag behind growth. A pass started by
        // node pool pressure takes max_visits_per_frame if that is larger.
        // 256..=16777216
        max_shrink_visits_per_frame: 4096,
        // Nodes the shrink walk collapses per frame at most (each releases
        // its subtree); it resumes where it stopped. 1..=1048576
        max_collapses_per_frame: 256,
        // Steps the beam prepass takes per 8x8 tile of camera rays to find
        // the distance they may all start from (decision 0023); 0 turns it
        // off and rays start at the camera. 0..=1024
        beam_iterations: 64,
    ),
    // Node summaries (each over up to 64 children) that applying edits and
    // replaced chunks may compute per frame; the rest waits for later
    // frames, nearest first. A replaced 16 m chunk
    // costs one per mixed node in it (up to about 6,000); a chunk's are
    // computed on up to 8 threads. Walking at 8 m/s needs 1,500 to 2,500 a
    // frame. 1..=16777216
    max_summaries_per_frame: 8192,
    // Tasks a replaced chunk's summaries are split into on the brick cache's
    // task pool; 0 picks one per pool thread (at most 8). 0..=64
    summary_threads: 0,
    // Records whose groups and bricks are freed per frame after a collapse or
    // a replaced chunk took them out of the tree; the rest wait, and nothing
    // below them is refined until they are freed. A refined 16 m chunk can
    // hold over 100,000. 256..=16777216
    max_frees_per_frame: 16384,
    // A small built-in scene while nothing feeds the renderer a world.
    debug_scene: true,
    // Animate a carve in the debug scene, exercising edit uploads.
    debug_scene_edits: true,
)
