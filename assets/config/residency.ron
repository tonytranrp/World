// World residency (decision 0006): what stays in memory around the player
// and where edits are saved. Hot-reloads on save; changing the seed reopens
// the world (edits are saved first).
(
    // The world seed.
    seed: 0x5EED,
    // Full-detail chunks (16 m) whose centre is this close are loaded, metres. 16.0..=512.0
    full_radius_m: 64.0,
    // They are evicted only beyond this distance, metres. At least full_radius_m.
    evict_radius_m: 96.0,
    // Coarse chunk columns reach this far horizontally, metres. 0.0 turns them off.
    coarse_radius_m: 384.0,
    // Coarse cells are 4^level voxels: 2 is a quarter metre. 1..=4
    coarse_cell_level: 2,
    // RAM for full-detail chunks, MiB. Far chunks go first when it is exceeded.
    hot_cap_mib: 1300,
    // RAM for compressed chunks after eviction, MiB: edited chunks, and generated
    // ones so walking back does not generate them again.
    warm_cap_mib: 400,
    // Edited chunks age this many times more slowly in that cache, so they stay
    // longer. 1.0..=64.0
    warm_edited_weight: 4.0,
    // RAM for coarse chunks, MiB.
    coarse_cap_mib: 500,
    // Worker threads for generation and saving. 0 runs everything on the main thread.
    workers: 4,
    // Chunks joined to the world per frame at most.
    grafts_per_frame: 8,
    // The edit log is folded into the region files (edited chunks written, the log
    // restarted from a checkpoint) each time it grows this much, KiB. 64..=1048576
    log_checkpoint_kib: 16384,
    // Region files and the edit log, relative to the working directory.
    save_dir: "saves/world",
    // The player's velocity, from successive camera positions, is averaged over
    // about this long, seconds. 0.0..=10.0
    velocity_smoothing_secs: 0.5,
    // While moving, chunks near where the player will be this many seconds ahead
    // load first, and a lookahead sphere there loads too. 0.0 turns it off. 0.0..=10.0
    prefetch_lookahead_secs: 2.0,
    // The lookahead sphere's radius, metres; it loads only once the full-detail
    // sphere is requested, and only out to evict_radius_m. 16.0..=1024.0
    prefetch_radius_m: 64.0,
    // RAM for column footprints (the heightfield under a chunk, 4 MiB each) shared
    // by the workers, so chunks stacked in a column compute it once, MiB. 0 turns
    // the cache off. 0, or 4..=16384
    column_cache_mib: 128,
    // Chunks entirely below the terrain surface load as if this much farther away,
    // metres, so the visible ones come first. 0.0..=1024.0
    buried_delay_m: 32.0,
)
